generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "darwin-arm64", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model request {
  id        Int            @id @default(autoincrement())
  unique    String         @db.VarChar(255)
  callback  String         @db.VarChar(300)
  state     String         @unique
  services  Json[]
  status    STATUS_REQUEST
  scope     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime?      @updatedAt()
}

model services {
  id        Int             @id @default(autoincrement())
  key       String          @unique /// Emongolia code
  code      SERVICES        @unique /// Custom code
  desc      String /// Description
  wsdl      String?
  status    STATUS_SERVICES @default(ACTIVE)
  params    Json
  createdAt DateTime        @default(now())
}

model payment {
  id        Int            @id @default(autoincrement())
  custid    String         @db.VarChar(255)
  amount    Decimal        @db.Decimal(20, 2)
  currency  String         @default("MNT") @db.VarChar(10)
  txntype   TXN_TYPE
  action    PAYMENT_ACTION
  ordernum  String?        @db.VarChar(255)
  tranid    String?        @db.VarChar(255)
  checkid   String?        @db.VarChar(255)
  status    String?        @db.VarChar(100) /// NEGDI order status
  negdiurl  String?        @db.VarChar(500)
  ordersign String?
  createdAt DateTime       @default(now())
  updatedAt DateTime?      @updatedAt()
}

model withdraw {
  id             Int             @id @default(autoincrement())
  custid         String?         @db.VarChar(255)
  acctType       String?         @db.VarChar(50) /// initiator bank_account type
  registerNumber String?         @db.VarChar(50)
  acctName       String          @db.VarChar(255)
  acctNo         String          @db.VarChar(100)
  bank           String          @db.VarChar(10)
  amount         Decimal         @db.Decimal(20, 2)
  currency       String          @default("MNT") @db.VarChar(10)
  description    String?         @db.VarChar(255)
  clientId       String?         @db.VarChar(255)
  state          String?         @db.VarChar(255)
  scope          String?         @db.VarChar(255)
  transferRes    Json?
  confirmRes     Json?
  error          String?
  status         STATUS_WITHDRAW @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime?       @updatedAt()
}

model bank_transaction {
  id          Int                @id @default(autoincrement())
  accountId   String             @db.VarChar(100)
  hash        String             @unique @db.VarChar(64)
  refno       String?            @db.VarChar(100)
  trandate    String?            @db.VarChar(50)
  amount      Decimal?           @db.Decimal(20, 2)
  drOrCr      String?            @db.VarChar(10)
  relatedAccount String?         @db.VarChar(100) /// counterparty account number
  description String?
  record      Json
  status      STATUS_TRANSACTION @default(PENDING) /// core system registration
  createdAt   DateTime           @default(now())
}

enum STATUS_TRANSACTION {
  PENDING
  REGISTERED
}

model job_run {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  status     STATUS_JOB @default(RUNNING)
  result     Json?
  error      String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
}

model bank_account {
  id        Int       @id @default(autoincrement())
  type      String    @unique @db.VarChar(50)
  bank      String    @db.VarChar(10)
  account   String    @db.VarChar(100)
  name      String    @db.VarChar(255)
  currency  String    @default("MNT") @db.VarChar(10)
  statement Boolean   @default(false) /// fetch statement for this account
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt()
}

enum STATUS_JOB {
  RUNNING
  DONE
  FAILED
}

enum STATUS_WITHDRAW {
  PENDING
  TRANSFERRED
  TRANSFER_FAILED
  CONFIRMED
  CONFIRM_FAILED
}

enum TXN_TYPE {
  FEE
  CHARGE
}

enum PAYMENT_ACTION {
  QR
  CARD
}

enum STATUS_REQUEST {
  PENDING
  DONE
  ENTERED
  FAILED
}

enum STATUS_SERVICES {
  ACTIVE
  INACTIVE
}

enum SERVICES {
  CITIZEN_ID_CARD_INFO
  CITIZEN_BIRTH_INFO
  CITIZEN_ADDRESS_INFO
  CITIZEN_MARRIAGE_INFO
  CITIZEN_MARRIAGE_DIVORCE_INFO
  AUTHORIZE_CITIZEN
  CITIZEN_INFO
  CHECK_CITIZEN_REGNUM
  CITIZEN_NO_MARRIEGE_INFO
  PROPERTY_INFO
  PROPERTY_LIST
  LEGAL_ENTITY_INFO_WITH_REGNUM
  VEHICLE_INFO_OLD
  VEHICLE_OWNER_HISTORY_LIST
  VEHICLE_PENALTY_LIST
  CITIZEN_VEHICLE_LIST
  DRIVER_LICENSE_INFO
  SALARY_INCOME
  CITIZEN_PENSION_INQUIRY
  TAX_PAYER_INFO
  VEHICLE_PAID_TAX_HISTORY
  VEHICLE_TAX_PAYABLE_INFO
  VEHICLE_INFO
}

# Port number
PORT=3000

NODE_ENV=dev

# PostgreSQL
POSTGRESQL_USER=root
POSTGRESQL_PASSWORD=rootpass
POSTGRESQL_DATABASE=app
POSTGRESQL_HOST=postgresql:5432

DATABASE_URL=postgresql://${POSTGRESQL_USER}:${POSTGRESQL_PASSWORD}@${POSTGRESQL_HOST}/${POSTGRESQL_DATABASE}?connect_timeout=300

# eMongolia OAuth
EMONGOLIA_CLIENT_ID=
EMONGOLIA_CLIENT_SECRET=
EMONGOLIA_URI=
EMONGOLIA_REDIRECT_URI=

# Redirect base URI (for the gateway's own callback URLs)
REDIRECT_URI=

# HES (RSA notif callback)
HES_CLIENT_ID=
HES_SALT=
HES_PUBLIC_KEY_PATH=
HES_API_KEY=

# Elastic APM (active only in prod)
APM_SECRET_TOKEN=
ELASTIC_URL=

# HES payment/transaction registration endpoints
HES_PAYMENT_URI=https://bds.techfi.mn/bdc/api/kyc/payment_status
# core endpoint receiving the transaction batch; register job stays disabled while empty
HES_TRANSACTION_URI=

# NEGDI payment gateway
NEGDI_URI=http://103.229.177.10:8032
NEGDI_TERMINAL_ID=222
NEGDI_USERNAME=TESTTERMINAL10
NEGDI_PASSWORD=TESTTERMINAL10
# payer returns here after payment; NEGDI appends ?tranid=&checkid=
NEGDI_RETURN_URL=https://mandalcapital.mn/dan/api/payment/check

# Golomt endpoints protection (/api/golomt/*)
X_API_KEY=
# comma separated allowlist; empty disables the IP check
ALLOWED_IPS=

# Golomt CGW
GOLOMT_URL=
GOLOMT_NAME=gmtbankapi
GOLOMT_PASSWORD=
GOLOMT_SESSION_KEY=
GOLOMT_IV_KEY=
GOLOMT_CLIENT_ID=
GOLOMT_SCOPE=
GOLOMT_REGISTER_NO=
# initiator bank code (15 = Golomt)
GOLOMT_BANK_CODE=15
# fallback only: normally obtained from the login response
GOLOMT_ACCESS_CODE=
